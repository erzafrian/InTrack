# TEMPLATE ONLY. Copy values into server/.env or backend hosting environment.
# Do not overwrite the current environment until the new services are ready.
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://NEW_USER:NEW_PASSWORD@NEW_HOST/intrack?sslmode=require
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=NEW_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=NEW_R2_SECRET_ACCESS_KEY
S3_BUCKET_NAME=intrack-files
# Current code needs a readable URL; private downloads require a code change.
S3_PUBLIC_URL=https://files.YOUR_DOMAIN
GOOGLE_CLIENT_ID=NEW_OAUTH_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=NEW_OAUTH_WEB_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback
NOTION_CLIENT_ID=NEW_PUBLIC_CONNECTION_CLIENT_ID
NOTION_CLIENT_SECRET=NEW_PUBLIC_CONNECTION_CLIENT_SECRET
NOTION_REDIRECT_URI=http://localhost:3001/api/auth/notion/callback
AI_API_KEY=NEW_GEMINI_API_KEY
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=REPLACE_WITH_AN_AVAILABLE_CHAT_MODEL_ID
FACE_SERVICE_URL=http://127.0.0.1:8001
OFFICE_LATITUDE=-6.2088
OFFICE_LONGITUDE=106.8456

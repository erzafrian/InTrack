{
  "name": "intrack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test server/test/*.test.js client/test/*.test.mjs",
    "db:migrate": "npm run db:migrate --prefix server",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "db:push": "cd server && npm run db:push",
    "db:seed": "cd server && npm run db:seed",
    "db:studio": "cd server && npm run db:studio"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
